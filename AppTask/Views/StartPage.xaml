<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppTask.Views.StartPage"
             NavigationPage.HasNavigationBar="false"
             Title="StartPage">
    <Grid RowDefinitions="80,*">
        <Entry Margin="20, 20, 20, 20" Placeholder="Pesquisar..."/>
        <Label Grid.Row="1" Text="O que você deseja fazer?" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource Gray400}"/>
        <Button Grid.Row="1" Text="+  Adicionar Tarefa"  Margin="15" HorizontalOptions="Center" VerticalOptions="End" Clicked="Button_Clicked"/>
    </Grid>
</ContentPage>